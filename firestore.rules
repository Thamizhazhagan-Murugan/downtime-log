rules_version = '2';
// Security rules for the Extrusion Downtime Log.
// Paste this whole file into Firebase console > Firestore Database > Rules, then Publish.
service cloud.firestore {
  match /databases/{database}/documents {

    // The one account that can make or remove admins. Keep it the same as superAdminEmail in js/config.js.
    function superEmail() { return 'ttthamizh66@gmail.com'; }

    function signedIn() { return request.auth != null; }
    function isSuper() {
      return signedIn()
        && request.auth.token.email == superEmail()
        && request.auth.token.email_verified == true;
    }
    function hasProfile() { return signedIn() && exists(/databases/$(database)/documents/users/$(request.auth.uid)); }
    function profile() { return get(/databases/$(database)/documents/users/$(request.auth.uid)).data; }
    function isActive() { return isSuper() || (hasProfile() && profile().status == 'active'); }
    function isAdmin() { return isSuper() || (isActive() && profile().role == 'admin'); }
    function onlyChanges(keys) { return request.resource.data.diff(resource.data).affectedKeys().hasOnly(keys); }

    // Machines, states, alarms and shifts.
    match /config/{doc} {
      allow read: if isActive();
      allow write: if isAdmin();
    }

    // One profile per signed-in account.
    match /users/{uid} {
      allow read: if isActive() || (signedIn() && request.auth.uid == uid);

      // Anyone signed in may create their own profile, but only as a pending user.
      allow create: if signedIn() && request.auth.uid == uid && (
        isSuper() || (
          request.resource.data.role == 'user'
          && request.resource.data.status == 'pending'
          && request.resource.data.email == request.auth.token.email.lower()
        )
      );

      allow update: if
        // People may change their own name or photo, nothing else.
        (signedIn() && request.auth.uid == uid && onlyChanges(['name', 'photo']))
        // Admins approve, decline or turn off users. They cannot change roles or touch other admins.
        || (isAdmin()
            && resource.data.role != 'admin'
            && onlyChanges(['status', 'approvedBy', 'approvedAt'])
            && request.resource.data.status in ['active', 'pending', 'disabled'])
        // Only the main admin changes roles.
        || isSuper();

      allow delete: if isSuper();
    }

    // Log entries: one per state change on a machine.
    match /events/{id} {
      allow read: if isActive();
      allow create: if isActive()
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.machine is string
        && request.resource.data.state is string
        && request.resource.data.at is number;
      allow update: if isAdmin()
        || (isActive() && resource.data.uid == request.auth.uid && request.resource.data.uid == request.auth.uid);
      allow delete: if isAdmin() || (isActive() && resource.data.uid == request.auth.uid);
    }

    // Clock-in sessions.
    match /sessions/{id} {
      allow read: if isActive();
      allow create: if isActive() && request.resource.data.uid == request.auth.uid;
      allow update: if isAdmin()
        || (isActive() && resource.data.uid == request.auth.uid && request.resource.data.uid == request.auth.uid);
      allow delete: if isSuper();
    }
  }
}
