rules_version = '2';
// Security rules for the Extrusion Downtime Log.
// Paste this whole file into Firebase console > Firestore Database > Rules, then Publish.
service cloud.firestore {
  match /databases/{database}/documents {

    // The one account that can make or remove admins. Keep it the same as superAdminEmail in js/config.js.
    function superEmail() { return 'ttthamizh66@gmail.com'; }

    function signedIn() { return request.auth != null; }
    function isSuper() {
      return signedIn()
        && request.auth.token.email == superEmail()
        && request.auth.token.email_verified == true;
    }
    function hasProfile() { return signedIn() && exists(/databases/$(database)/documents/users/$(request.auth.uid)); }
    function profile() { return get(/databases/$(database)/documents/users/$(request.auth.uid)).data; }
    function isActive() { return isSuper() || (hasProfile() && profile().status == 'active'); }
    function isAdmin() { return isSuper() || (isActive() && profile().role == 'admin'); }
    // Team: 'operator' (default) or 'maintenance'. Maintenance also keeps the maintenance job log.
    function isMaint() { return isActive() && hasProfile() && profile().get('team', 'operator') == 'maintenance'; }
    function onlyChanges(keys) { return request.resource.data.diff(resource.data).affectedKeys().hasOnly(keys); }

    // Machines, states, alarms and shifts.
    match /config/{doc} {
      allow read: if isActive();
      allow write: if isAdmin();
    }

    // One profile per signed-in account.
    match /users/{uid} {
      allow read: if isActive() || (signedIn() && request.auth.uid == uid);

      // Anyone signed in may create their own profile, but only as a pending user.
      allow create: if signedIn() && request.auth.uid == uid && (
        isSuper() || (
          request.resource.data.role == 'user'
          && request.resource.data.status == 'pending'
          && request.resource.data.get('team', 'operator') == 'operator'
          && request.resource.data.email == request.auth.token.email.lower()
        )
      );

      allow update: if
        // People may change their own name or photo, nothing else.
        (signedIn() && request.auth.uid == uid && onlyChanges(['name', 'photo']))
        // Admins approve, decline or turn off users and set their team. They cannot change roles or touch other admins.
        || (isAdmin()
            && resource.data.role != 'admin'
            && onlyChanges(['status', 'approvedBy', 'approvedAt', 'team'])
            && request.resource.data.status in ['active', 'pending', 'disabled']
            && request.resource.data.get('team', 'operator') in ['operator', 'maintenance'])
        // Only the main admin changes roles.
        || isSuper();

      // Removing someone from the app: the main admin can remove anyone but themselves;
      // other admins can remove people who are not admins. Their past entries are kept.
      allow delete: if (isSuper() && request.auth.uid != uid)
        || (isAdmin() && request.auth.uid != uid && resource.data.role != 'admin');
    }

    // Log entries: one per state change on a machine.
    match /events/{id} {
      allow read: if isActive();
      allow create: if isActive()
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.machine is string
        && request.resource.data.state is string
        && request.resource.data.at is number;
      allow update: if isAdmin()
        || (isActive() && resource.data.uid == request.auth.uid && request.resource.data.uid == request.auth.uid)
        // Maintenance may change only the description on someone else's entry.
        || (isMaint() && onlyChanges(['note', 'updatedAt', 'noteBy', 'noteByName']) && request.resource.data.noteBy == request.auth.uid);
      allow delete: if isAdmin() || (isActive() && resource.data.uid == request.auth.uid);
    }

    // Maintenance jobs: any equipment or place. Maintenance team and admins only.
    match /work/{id} {
      allow read: if isAdmin() || isMaint();
      allow create: if (isAdmin() || isMaint())
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.equipment is string && request.resource.data.equipment.size() > 0
        && request.resource.data.start is number;
      allow update: if (isAdmin() || (isMaint() && resource.data.uid == request.auth.uid))
        && request.resource.data.uid == resource.data.uid
        && request.resource.data.start is number;
      allow delete: if isAdmin() || (isMaint() && resource.data.uid == request.auth.uid);
    }

    // Clock-in sessions.
    match /sessions/{id} {
      allow read: if isActive();
      allow create: if isActive() && request.resource.data.uid == request.auth.uid;
      allow update: if isAdmin()
        || (isActive() && resource.data.uid == request.auth.uid && request.resource.data.uid == request.auth.uid);
      allow delete: if isSuper();
    }
  }
}
